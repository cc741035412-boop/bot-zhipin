{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jakob52123/bot-zhipin/schema/bot.schema.json",
  "title": "bot.yaml",
  "description": "一个 Bot 的卡片和详情页信息。枚举值是全站唯一真源，网站和校验器都从这里读。",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "name", "tagline", "category", "author", "templateUrl", "addedAt", "prerequisites", "quotaCost", "permissions"],
  "properties": {
    "slug": {
      "description": "和文件夹同名。只能用小写字母、数字和短横线，2 到 40 个字符。",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 40
    },
    "name": { "description": "Bot 的名字", "type": "string", "minLength": 1, "maxLength": 20, "pattern": "^[^<>\"]*$" },
    "tagline": { "description": "一句话介绍", "type": "string", "minLength": 4, "maxLength": 40, "pattern": "^[^<>\"]*$" },
    "category": {
      "description": "分类",
      "enum": ["调研", "定义", "评审", "AI 评测", "学习", "求职", "日常", "基础设施"]
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "description": "作者名字", "type": "string", "minLength": 1, "maxLength": 40 },
        "github": {
          "description": "GitHub 用户名，不带 @",
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38}$"
        },
        "url": { "description": "作者主页，只有外部收录且没有 GitHub 时才用", "type": "string", "pattern": "^https://" }
      }
    },
    "templateUrl": {
      "description": "x.ai 模板分享链接",
      "type": "string",
      "pattern": "^https://x\\.ai/bot/[A-Za-z0-9_-]+$"
    },
    "addedAt": {
      "description": "上架日期，YYYY-MM-DD，「最新」排序用",
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "prerequisites": {
      "description": "导入前要准备什么。没有就写「无」。可以写一句话，也可以写成列表。",
      "anyOf": [
        { "type": "string", "minLength": 1, "maxLength": 200 },
        { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 100 } }
      ]
    },
    "quotaCost": { "description": "额度消耗", "enum": ["低", "中", "高"] },
    "permissions": {
      "description": "会用到的权限，从固定列表里选；一个都不用就写 []",
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["云电脑文件", "浏览器 Cookie", "外部账号", "联网", "定时自动运行", "代我发消息"] }
    },
    "pitch": { "description": "自荐台词（可选）", "type": "string", "minLength": 2, "maxLength": 30, "pattern": "^[^<>\"]*$" },
    "forkedFrom": {
      "description": "改编自哪个 Bot 的 slug（可选）",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "external": { "description": "外部收录（可选）。为 true 时 ROLE.md、DESIGN.md、skills、截图都不强制。", "type": "boolean" }
  },
  "if": {
    "properties": { "external": { "const": true } },
    "required": ["external"]
  },
  "then": {},
  "else": {
    "properties": { "author": { "type": "object", "required": ["name", "github"] } }
  }
}
